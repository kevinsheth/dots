#!/usr/bin/env sh

# Load scripting addition (required for create/move space)
sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# Omarchy-style sharp layout
yabai -m config layout bsp
yabai -m config window_gap 10
yabai -m config window_shadow off

# Tight padding with room for SketchyBar
yabai -m config top_padding 38
yabai -m config bottom_padding 10
yabai -m config left_padding 10
yabai -m config right_padding 10

yabai -m config auto_balance off
yabai -m config split_ratio 0.50
yabai -m config window_placement second_child

yabai -m config focus_follows_mouse off
yabai -m config mouse_follows_focus off
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

# Ensure at least 6 spaces exist
SPACE_COUNT=$(yabai -m query --spaces | jq 'length')
while [ "$SPACE_COUNT" -lt 6 ]; do
  yabai -m space --create
  SPACE_COUNT=$((SPACE_COUNT + 1))
done

# Float apps that should stay floating
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^Raycast$" manage=off

# Start borders with yabai
borders active_color=0xff71CEAD inactive_color=0x6633372B width=4.0 style=round &
